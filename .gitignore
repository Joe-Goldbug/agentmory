# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# macOS
.DS_Store
**/.DS_Store

# LLM-WorkMem runtime symlinks (machine-specific, point to ~/Library/Application Support/lwm-runtime/)
# These are symlinks with spaces in the name, hard to pattern-match in .gitignore
# Workaround: add with explicit paths via shell. See sync script.

# Ghost duplicates of the runtime symlinks (wiki 2/, raw 2/, automation 2/)
# that macOS sometimes creates; defensively ignored.
"wiki 2/"
"raw 2/"
"automation 2/"
"wiki 2"
"raw 2"
"automation 2"

# Dashboard build artifacts (regenerated by `lwm dashboard`)
knowledge-digest.pages/

# Trae IDE local cache (per-machine, not for the repo)
/.trae/

# Personal planning scratchpad (work-in-progress notes, not deliverables)
/plans/

# launchd harvest logs (rewritten on every run; runtime artefact only)
/automation/logs/

# LLM-WorkMem sync boundary
# `state/` is a machine-local runtime projection (health, receipts, paths and
# supervisor state). Durable memory lives in GLOBAL.md, projects/, wiki/ and
# sanitized source evidence, so state must be regenerated on each machine.
/state/*
!/state/README.md

# Local tool/session continuation data and test residue.
/.omo/
/lwm/_test_write.tmp

# A local backup may contain machine-specific configuration or credentials.
/global/config/mcp_config.json.backup

# These are independent Antigravity working trees, not content owned by this
# repository. Their LLM-WorkMem instruction overlays above remain versioned.
/projects/antigravity/kind-meitner/
/projects/antigravity/zealous-archimedes/

# Tool snapshot data (auto-harvested per-machine; large, not for version control)
/raw/tool-snapshots/

# Local dev helper script (not a project deliverable)
/fix-venv.sh

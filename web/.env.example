# 复制为 .env.local 后生效

# 网关 API 基址。留空 = 走 Vite 同源代理 /api -> http://127.0.0.1:8766（推荐，规避 CORS）
VITE_LWM_API_BASE=

# mock 兜底开关：=1 时前端完全不发请求，adapter 返回 web/src/mocks 下的数据
# 用于后端网关未启动 / lwm 服务不可用时的 UI 演示
VITE_LWM_USE_MOCK=1

# 默认展示的项目绝对路径（对应后端的 project_path，会被解析为 git-<hash> 项目身份）
VITE_LWM_PROJECT_PATH=D:\\start-up\\LLM-WorkMem

# 默认工具标识（对应 lwm hub context --tool <tool>）
VITE_LWM_TOOL=codex

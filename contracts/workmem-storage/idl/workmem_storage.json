{
  "version": "0.1.0",
  "name": "workmem_storage",
  "instructions": [
    {
      "name": "initializeQuota",
      "accounts": [
        { "name": "userQuota", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "buyQuotaWithTokens",
      "accounts": [
        { "name": "userQuota", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "userTokenAccount", "isMut": true, "isSigner": false },
        { "name": "treasuryTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "tokenAmount", "type": "u64" },
        { "name": "quotaToAdd", "type": "u64" }
      ]
    },
    {
      "name": "buyQuotaWithSol",
      "accounts": [
        { "name": "userQuota", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "treasury", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "lamports", "type": "u64" },
        { "name": "quotaToAdd", "type": "u64" }
      ]
    },
    {
      "name": "commitSnapshot",
      "accounts": [
        { "name": "userQuota", "isMut": true, "isSigner": false },
        { "name": "snapshotRecord", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "projectId", "type": { "array": ["u8", 32] } },
        { "name": "version", "type": "u32" },
        { "name": "snapshotHash", "type": { "array": ["u8", 32] } },
        { "name": "encryptedUri", "type": "string" },
        { "name": "tool", "type": "string" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "UserQuota",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "availableCommits", "type": "u64" },
          { "name": "totalCommits", "type": "u64" },
          { "name": "lastCommitTimestamp", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "SnapshotRecord",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "projectId", "type": { "array": ["u8", 32] } },
          { "name": "version", "type": "u32" },
          { "name": "snapshotHash", "type": { "array": ["u8", 32] } },
          { "name": "encryptedUri", "type": "string" },
          { "name": "tool", "type": "string" },
          { "name": "timestamp", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "QuotaPurchasedEvent",
      "fields": [
        { "name": "user", "type": "publicKey", "index": false },
        { "name": "tokenAmount", "type": "u64", "index": false },
        { "name": "quotaAdded", "type": "u64", "index": false },
        { "name": "totalAvailable", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "QuotaPurchasedWithSolEvent",
      "fields": [
        { "name": "user", "type": "publicKey", "index": false },
        { "name": "lamports", "type": "u64", "index": false },
        { "name": "quotaAdded", "type": "u64", "index": false },
        { "name": "totalAvailable", "type": "u64", "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "SnapshotCommittedEvent",
      "fields": [
        { "name": "owner", "type": "publicKey", "index": false },
        { "name": "projectId", "type": { "array": ["u8", 32] }, "index": false },
        { "name": "version", "type": "u32", "index": false },
        { "name": "snapshotHash", "type": { "array": ["u8", 32] }, "index": false },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    }
  ],
  "errors": [
    { "code": 6000, "name": "InvalidAmount", "msg": "代币支付数量必须大于 0" },
    { "code": 6001, "name": "InvalidQuota", "msg": "购买额度必须大于 0" },
    { "code": 6002, "name": "Overflow", "msg": "配额计算溢出" },
    { "code": 6003, "name": "InsufficientQuota", "msg": "当前可用链上存储额度不足，请先支付代币充值额度" }
  ]
}

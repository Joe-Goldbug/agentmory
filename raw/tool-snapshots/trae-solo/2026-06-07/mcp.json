{
  "mcpServers": {
    "Fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {}
    },
    "Playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {},
      "fromGalleryId": "executeautomation.mcp-playwright"
    },
    "DuckDuckGo Search Server": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "env": {},
      "fromGalleryId": "nickclyde.duckduckgo-mcp-server"
    },
    "File System": {
      "command": "npx -y @bunas/fs-mcp@latest",
      "args": [],
      "env": {
        "API_KEY": ""
      },
      "fromGalleryId": "bunasQ.fs"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      },
      "fromGalleryId": "upstash.context7"
    },
    "Sequential Thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "fromGalleryId": "modelcontextprotocol.servers_sequentialthinking"
    },
    "Memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "memory.json"
      },
      "fromGalleryId": "modelcontextprotocol.servers_memory"
    }
  }
}

{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.reviewSelection.enabled": true,
  "github.copilot.chat.claudeAgent.enabled": true,
  "github.copilot.chat.newWorkspaceCreation.enabled": true,
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": true,
  "chat.useAgentSkills": true,
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "github.copilot.chat.enabled": true,
  "github.copilot.chat.language": "zh-CN",
  "github.copilot.chat.quickFixes.enabled": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "editor.inlineSuggest.enabled": true,
  "chat.agentSessionProjection.enabled": true,
  "chat.tools.urls.autoApprove": {
    "https://www.happify.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "accessibility.audioCues.enabled": "on",
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "terminal.integrated.enableVisualBell": true,
  "editor.accessibilitySupport": "off",
  "kiroAgent.configureMCP": "Disabled",
  "kiroAgent.agentAutonomy": "Autopilot",
  "kiroAgent.modelSelection": "auto",
  "workbench.editor.enablePreview": false,
  "window.restoreWindows": "folders",
  "kiroAgent.enableTabAutocomplete": true,
  "kiroAgent.notifications.agent.success": true,
  "kiroAgent.notifications.agent.failure": true
}